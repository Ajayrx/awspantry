# ── SmartPantry backend environment ──────────────────────────────────
# Copy to .env and fill in. NEVER commit .env or real credentials.

# development | test | staging | production
# production refuses to start without a strong JWT secret.
ENVIRONMENT=development

# PostgreSQL (local, Docker or Amazon RDS). SQLAlchemy 2 URL form:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartpantry

# JWT signing secret — REQUIRED anywhere the app runs.
# Generate with:  openssl rand -hex 32
# (must be >= 32 chars in staging/production)
JWT_SECRET_KEY=replace-with-a-long-random-secret-generated-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080          # 7 days

# AWS (Bedrock recipes, Textract OCR, S3 receipts).
# Leave blank in local dev — the API then uses its deterministic
# fallback recipe generator and returns 503 for the OCR endpoint.
# IAM credentials may also come from the standard AWS chain (env profile,
# ~/.aws/credentials, ECS/EC2 instance role) — never hardcode them.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIASOQZARVITF6OKVWX
AWS_SECRET_ACCESS_KEY=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
AWS_S3_BUCKET=smartpantry-receipts-2026 

# Textract uses the same AWS_REGION + credentials; OCR accepts JPEG/PNG/PDF.
# Any Bedrock Converse-capable model, e.g.:
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
GOOGLE_CLIENT_ID= 450871737217-97vide8jpnhbf0vfijevro0t7okh5p9c.apps.googleusercontent.com

# CORS — the Vite dev server; set to your deployed frontend in prod.
FRONTEND_URL=http://localhost:5173

# Receipt upload hard limit (MB) and default currency for purchases.
MAX_UPLOAD_SIZE_MB=5
DEFAULT_CURRENCY=INR
